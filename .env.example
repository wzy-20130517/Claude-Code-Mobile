# Claude Code Mobile - 环境变量模板
# 复制为 .env 并填真实值；config.json 里用 ${VAR} 引用。
# .env 会被自动加载（项目根目录 或 ~/.claude-code-mobile/.env），已存在的环境变量优先。

# ===== Provider API Key（config.json 里写 ${XXX} 占位符，如 "apiKey": "${SOTAMODEL_KEY}"）=====
# 每个 Provider 都可以用不同变量名，自己定：
SOTAMODEL_KEY=sk-xxxx
MCCROX_KEY=sk-xxxx
DEEPSEEK_KEY=sk-xxxx
GROK_KEY=sk-xxxx

# ===== 联网搜索（Tavily）=====
# 不设置则 WebSearch 报错"未配置"
TAVILY_API_KEY=tvly-xxxx

# ===== 可选覆盖（等价旧版环境变量）=====
# API_URL=https://xxx/v1
# API_KEY=sk-xxx
# API_MODEL=model-name
